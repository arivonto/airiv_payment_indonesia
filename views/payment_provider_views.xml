<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="payment_provider_form_indonesia" model="ir.ui.view">
            <field name="name">payment.provider.form.indonesia</field>
            <field name="model">payment.provider</field>
            <field name="inherit_id" ref="payment.payment_provider_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='provider_credentials']" position="inside">
                    <group string="Indonesian Tri-Gateway Configuration"
                           invisible="code not in ('midtrans', 'xendit', 'paypal')">
                        <field name="id_merchant_id"/>
                        <field name="id_client_key"/>
                        <field name="id_server_key" password="True"/>
                        <field name="id_environment"/>
                        <field name="id_enable_qris"/>
                        <field name="id_enable_va"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="action_payment_provider_indonesia" model="ir.actions.act_window">
            <field name="name">Payment Gateways (Indonesia)</field>
            <field name="res_model">payment.provider</field>
            <field name="view_mode">list,kanban,form</field>
        </record>
    </data>
</odoo>
