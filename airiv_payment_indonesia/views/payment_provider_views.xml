<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_indonesia" model="ir.ui.view">
        <name>payment.provider.form.indonesia</name>
        <model>payment.provider</model>
        <inherit_id ref="payment.payment_provider_form"/>
        <arch type="xml">
            <xpath expr="//page[@name='credentials']" position="inside">
                <group invisible="code != 'midtrans'" string="Midtrans Credentials">
                    <field name="midtrans_merchant_id" required="code == 'midtrans' and state != 'disabled'"/>
                    <field name="midtrans_client_key" required="code == 'midtrans' and state != 'disabled'"/>
                    <field name="midtrans_server_key" password="True" required="code == 'midtrans' and state != 'disabled'"/>
                    <field name="midtrans_is_production"/>
                </group>
                <group invisible="code != 'xendit'" string="Xendit Credentials">
                    <field name="xendit_secret_key" password="True" required="code == 'xendit' and state != 'disabled'"/>
                    <field name="xendit_webhook_token" password="True"/>
                </group>
                <group invisible="code != 'paypal_rest'" string="PayPal REST v2 Credentials">
                    <field name="paypal_rest_client_id" required="code == 'paypal_rest' and state != 'disabled'"/>
                    <field name="paypal_rest_client_secret" password="True" required="code == 'paypal_rest' and state != 'disabled'"/>
                    <field name="paypal_rest_environment"/>
                </group>
            </xpath>
        </arch>
    </record>
</odoo>
